{
  "expo": {
    "name": "운Pick",
    "slug": "woonpick",
    "scheme": "woonpick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "description": "오늘의 운, 하나만 Pick! 사주 · 점성술(서양·인도·태국) · MBTI · 혈액형을 겹쳐 읽는 오늘의 운세.",
    "primaryColor": "#22293F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.woonpick.ios",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "운Pick"
      }
    },
    "android": {
      "package": "com.woonpick.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#CFEBFF"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "운Pick · 오늘의 운, 하나만 Pick!",
      "shortName": "운Pick",
      "themeColor": "#22293F",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#8CCBFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1B3550"
          }
        }
      ]
    ]
  }
}
