{
  "expo": {
    "name": "한장",
    "slug": "hanjang",
    "scheme": "hanjang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EEE4",
    "description": "매일 한 장, 나를 읽다. 사주 · 태국 점성술 · MBTI · 혈액형을 겹쳐 읽는 오늘의 운세.",
    "primaryColor": "#22293F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.hanjang.ios",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "한장"
      }
    },
    "android": {
      "package": "app.hanjang.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22293F"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "한장 · 매일 한 장, 나를 읽다",
      "shortName": "한장",
      "themeColor": "#22293F",
      "backgroundColor": "#F3EEE4",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3EEE4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#F3EEE4"
          }
        }
      ]
    ]
  }
}
