{
  "expo": {
    "name": "WHO AM I?",
    "slug": "whoami-saju",
    "scheme": "whoami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EEE4",
    "description": "나는 어떤 사람일까? 사주 · 태국 점성술 · MBTI · 혈액형을 겹쳐 읽어 나를 알아가는 운세 앱.",
    "primaryColor": "#22293F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.whoamisaju.ios",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "WHO AM I?"
      }
    },
    "android": {
      "package": "com.whoamisaju.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22293F"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "WHO AM I? · 나는 어떤 사람일까",
      "shortName": "WHO AM I?",
      "themeColor": "#22293F",
      "backgroundColor": "#F3EEE4",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3EEE4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#F3EEE4"
          }
        }
      ]
    ]
  }
}
